# Public site URL — used for canonical URLs, sitemap, OG tags
NUXT_PUBLIC_SITE_URL=https://karsastudio.com

# Cloudflare Turnstile (public site key is safe to expose)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (public, safe to expose)
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (service role key is SERVER-ONLY — never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret (SERVER-ONLY)
TURNSTILE_SECRET_KEY=

# Resend (SERVER-ONLY)
RESEND_API_KEY=
RESEND_FROM_EMAIL=studio@karsastudio.com
KARSA_INQUIRY_EMAIL=hello@karsastudio.com
